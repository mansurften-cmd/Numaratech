# Custom response headers for Cloudflare Workers static assets.
# https://developers.cloudflare.com/workers/static-assets/headers/
#
# This is a Workers deploy, not Pages (see wrangler.toml). _headers is native to
# both, with one Workers caveat that does not bite here: it is not applied to
# responses generated by Worker code. wrangler.toml declares no `main` and no
# run_worker_first, so every response is a static asset and every rule applies.
#
# Where several rules match one request, all of their headers are applied, and
# for a header set more than once the LAST matching rule wins. The immutable
# cache rules below therefore have to sit after the /* block that they override.

/*
  # Fonts, styles, scripts and images are all first party, so the policy stays
  # tight. The one external origin is api.web3forms.com, which the contact form
  # posts to — allowed in connect-src for the fetch path and in form-action for
  # the no-JavaScript native submit. 'unsafe-inline' is required for style
  # because Astro inlines small stylesheets and components emit scoped styles.
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.web3forms.com; form-action 'self' https://api.web3forms.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  # Temporary host — see public/robots.txt. Remove on launch to the real domain.
  X-Robots-Tag: noindex, nofollow
  # Revalidate by default, so a deploy is visible immediately. This used to be
  # a /*.html rule, which never matched anything: Astro builds with
  # trailingSlash 'always' and format 'directory', and html_handling
  # auto-trailing-slash redirects /about/index.html to /about/, so a request
  # path ending in .html is never actually served. Setting it on /* and letting
  # the immutable rules below override is what makes it take effect.
  Cache-Control: public, max-age=0, must-revalidate

# Fonts and hashed build assets are immutable — cache them hard. These come
# after /* deliberately: last matching rule wins for a repeated header.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/_astro/*
  Cache-Control: public, max-age=31536000, immutable
