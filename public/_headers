# Cloudflare Pages custom headers.
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  # No third-party origin is used: fonts, styles and scripts are all first
  # party, so the policy can be strict. 'unsafe-inline' is required for style
  # because Astro inlines small stylesheets and components emit scoped styles.
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

# Fonts and hashed build assets are immutable — cache them hard.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# HTML should always be revalidated so a deploy is visible immediately.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Enquiries must never be cached anywhere.
/api/*
  Cache-Control: no-store
