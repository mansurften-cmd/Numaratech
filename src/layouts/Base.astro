---
/**
 * The 2a shell. Every page uses this: SEO head, the dark nav band, the page
 * body, the closing band (optional) and the footer.
 *
 * The nav sits inside the page's own dark hero when `heroNav` is true (the
 * pattern the homepage and platform page use) — pages that open on white keep
 * the nav as its own dark band.
 */
import { SITE } from '../consts';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/nt-2a.css';

interface Props {
  title: string;
  description?: string;
  /** Set when the page renders its own dark hero and includes <Nav /> itself. */
  ownNav?: boolean;
  /** Set on pages that must not be indexed (404). */
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  ownNav = false,
  noindex = false,
} = Astro.props;

const organisation = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  legalName: SITE.legalName,
  url: SITE.url,
  description: SITE.description,
  email: SITE.email,
  telephone: SITE.phoneHref,
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.address.line1,
    addressLocality: SITE.address.city,
    addressCountry: 'AE',
  },
};
const pageTitle = title === SITE.name ? `${SITE.name} — ${SITE.tagline}` : `${title} — ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
---

<!doctype html>
<html lang="en-AE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:type" content="website" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#061a34" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <!-- Inter and JetBrains Mono are self-hosted from public/fonts and declared
         in global.css. The handoff loaded them from Google's CDN, which this
         site's Content-Security-Policy blocks (font-src 'self'; style-src is
         'self' 'unsafe-inline', so inline styles are permitted but external
         stylesheets are not) — and which would be a slower third request for typefaces we
         already ship. Same two families, no external origin. -->
    <link
      rel="preload"
      href="/fonts/inter-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-latin-500-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(organisation)}
    />
  </head>
  <body class="nt">
    <a class="nt-skip" href="#main">Skip to content</a>
    {
      !ownNav && (
        <div class="nt-dark">
          <div class="nt-grid"></div>
          <Nav />
        </div>
      )
    }
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
