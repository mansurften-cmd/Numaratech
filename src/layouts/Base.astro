---
/**
 * The 2a shell. Every page uses this: SEO head, the dark nav band, the page
 * body, the closing band (optional) and the footer.
 *
 * The nav sits inside the page's own dark hero when `heroNav` is true (the
 * pattern the homepage and platform page use) — pages that open on white keep
 * the nav as its own dark band.
 */
import { SITE } from '../consts';
import { ogSlug } from '../og';
import { NAV } from '../consts';
import { SERVICE_GROUPS } from '../services';
import { INSIGHTS } from '../insights';
import { PEOPLE } from '../people';
import { BRIEFS, BRIEF_SERIES } from '../briefs';
import { KEY_SERVICES } from '../key-services';
import { CASE_STUDIES } from '../case-studies';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/nt-2a.css';

interface Props {
  title: string;
  /** Search-result title. The visible headline stays the brand voice; this
   *  carries the words people search for. "— NUMARATECH" is appended. */
  seoTitle?: string;
  description?: string;
  /** Extra schema.org nodes for this page (e.g. the Service entries on an
   *  advisory group page). Emitted in one @graph block. */
  schema?: Record<string, unknown>[];
  /** Set on pages that must not be indexed (404). */
  noindex?: boolean;
  /** Override the generated Open Graph card. Site-relative path. */
  ogImage?: string;
  /** Present on insight pages; emits the Article block. */
  article?: {
    datePublished: string;
    dateModified?: string;
    author: { type: 'Person' | 'Organization'; name: string; url: string; jobTitle?: string };
    section: string;
  };
}

const {
  title,
  seoTitle,
  schema = [],
  description = SITE.description,
  noindex = false,
  ogImage,
  article,
} = Astro.props;

// AccountingService is a subtype of ProfessionalService and of LocalBusiness,
// which is what this actually is — Organization alone said nothing about what
// the business does or where it operates (A9). Its fixed fees are the
// OfferCatalog on /fees/, referenced here by @id rather than restated, so
// src/fees.ts stays the only place a price lives.
const organisation = {
  '@context': 'https://schema.org',
  '@type': 'AccountingService',
  '@id': `${SITE.url}/#organisation`,
  name: SITE.name,
  legalName: SITE.legalName,
  url: SITE.url,
  description: SITE.description,
  email: SITE.email,
  telephone: SITE.phoneHref,
  address: {
    '@type': 'PostalAddress',
    addressLocality: SITE.address.city,
    addressCountry: 'AE',
  },
  areaServed: { '@type': 'Country', name: 'United Arab Emirates', identifier: 'AE' },
  // The mark search engines may show beside the business name.
  logo: { '@type': 'ImageObject', url: `${SITE.url}/icon-512.png`, width: 512, height: 512 },
  image: `${SITE.url}/og/index.png`,
  knowsAbout: [
    'UAE Corporate Tax',
    'UAE VAT',
    'Transfer pricing',
    'IFRS financial statements',
    'Bookkeeping and management accounts',
    'Audit file preparation',
    'Anti-money laundering compliance',
    'Ultimate beneficial ownership filing',
  ],
  hasOfferCatalog: { '@id': `${SITE.url}/fees/#catalog` },
  ...(SITE.sameAs.length ? { sameAs: [...SITE.sameAs] } : {}),
  // The founder's full Person record is on /about/, under this @id.
  founder: PEOPLE.filter((person) => person.role === 'Founder').map((person) => ({
    '@type': 'Person',
    '@id': `${SITE.url}/about/#${person.id}`,
    name: person.name,
  })),
  identifier: {
    '@type': 'PropertyValue',
    propertyID: `${SITE.licence.authorityShort} trade licence`,
    value: SITE.licence.number,
  },
};

/* Breadcrumbs, derived from the path so a new page cannot ship without them.
   Segment labels come from the real content where it exists — a service group
   is "Tax & Advisory", not "Tax" — and fall back to a title-cased segment. */
const SEGMENT_LABELS = new Map<string, string>([
  ...NAV.map((item) => [item.href.replace(/\//g, ''), item.label] as [string, string]),
  ...SERVICE_GROUPS.map((group) => [group.slug, group.name] as [string, string]),
  ...INSIGHTS.map((insight) => [insight.slug, insight.title] as [string, string]),
  ...BRIEFS.map((brief) => [brief.slug, brief.title] as [string, string]),
  ...KEY_SERVICES.map((page) => [page.slug, page.name] as [string, string]),
  ...CASE_STUDIES.map((study) => [study.slug, study.title] as [string, string]),
  ['fees', 'Fixed fees'],
  ['case-studies', 'Case studies'],
  ['regulatory-brief', BRIEF_SERIES.name],
  ['small-business-relief-check', 'Small Business Relief Check'],
  ['platform', 'Platform'],
  ['insights', 'Insights'],
]);

const titleCase = (segment: string) =>
  segment.replace(/-/g, ' ').replace(/(^|\s)\w/g, (c) => c.toUpperCase());

const segments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumb =
  segments.length === 0
    ? null
    : {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { name: 'Home', path: '/' },
          ...segments.map((segment, i) => ({
            name: SEGMENT_LABELS.get(segment) ?? titleCase(segment),
            path: `/${segments.slice(0, i + 1).join('/')}/`,
          })),
        ].map((crumb, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: crumb.name,
          item: new URL(crumb.path, SITE.url).href,
        })),
      };
// Search results show about 60 characters. The brand is appended where it
// fits; a long article headline stands alone rather than being cut off.
const suffix = ` — ${SITE.name}`;
const head = seoTitle ?? title;
const pageTitle =
  title === SITE.name
    ? `${SITE.name} — ${SITE.titleTag}`
    : head.length + suffix.length <= 60
      ? `${head}${suffix}`
      : head;
const isHome = Astro.url.pathname === '/';

// Google reads the site name it shows in results from WebSite data on the
// home page.
const websiteSchema = isHome
  ? {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      name: SITE.name,
      alternateName: SITE.legalName,
      url: `${SITE.url}/`,
      inLanguage: 'en-AE',
      publisher: { '@id': `${SITE.url}/#organisation` },
    }
  : null;
const graphSchema = schema.length ? { '@context': 'https://schema.org', '@graph': schema } : null;
const canonical = new URL(Astro.url.pathname, SITE.url).href;

// Absolute, because Open Graph consumers do not resolve relative URLs.
const ogImageUrl = new URL(ogImage ?? `/og/${ogSlug(Astro.url.pathname)}.png`, SITE.url).href;

const articleSchema = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description,
      datePublished: article.datePublished,
      dateModified: article.dateModified ?? article.datePublished,
      articleSection: article.section,
      author: {
        '@type': article.author.type,
        ...(article.author.type === 'Person' ? { '@id': article.author.url } : {}),
        name: article.author.name,
        url: article.author.url,
        ...(article.author.jobTitle ? { jobTitle: article.author.jobTitle } : {}),
      },
      publisher: { '@id': `${SITE.url}/#organisation` },
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
      image: ogImageUrl,
      inLanguage: 'en-AE',
    }
  : null;
---

<!doctype html>
<html lang="en-AE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    {
      article && (
        <>
          <meta property="article:published_time" content={article.datePublished} />
          <meta property="article:modified_time" content={article.dateModified ?? article.datePublished} />
          <meta property="article:section" content={article.section} />
        </>
      )
    }
    {/* Large image previews in results, once the site is indexable. The
        pre-launch X-Robots-Tag header still keeps everything out until then. */}
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="max-image-preview:large" />}
    <meta name="theme-color" content="#061a34" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} — ${SITE.name}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Inter and JetBrains Mono are self-hosted from public/fonts and declared
         in global.css. The handoff loaded them from Google's CDN, which this
         site's Content-Security-Policy blocks (font-src 'self'; style-src is
         'self' 'unsafe-inline', so inline styles are permitted but external
         stylesheets are not) — and which would be a slower third request for typefaces we
         already ship. Same two families, no external origin. -->
    <link
      rel="preload"
      href="/fonts/inter-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-latin-500-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(organisation)}
    />
    {
      breadcrumb && (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
      )
    }
    {
      websiteSchema && (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
      )
    }
    {
      graphSchema && (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(graphSchema)} />
      )
    }
    {
      articleSchema && (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
      )
    }
  </head>
  <body class="nt">
    <a class="nt-skip" href="#main">Skip to content</a>
    <!-- The nav is a banner landmark outside <main>, so the skip link actually
         bypasses it. Previously PageHero rendered <Nav /> inside its own dark
         wrapper, which sat inside <main> — the skip link landed the user
         immediately before the navigation it exists to skip (WCAG 2.4.1). -->
    <header class="nt-dark nt-header">
      <Nav />
    </header>
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
