---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import NextBand from '../../components/NextBand.astro';
import Arrow from '../../components/Arrow.astro';
import { insightsNewestFirst, formatInsightDate } from '../../insights';
import { BRIEF_SERIES, briefsNewestFirst } from '../../briefs';

const insights = insightsNewestFirst();
const latestBrief = briefsNewestFirst()[0];
---

<Base
  title="Insights"
  seoTitle="UAE Corporate Tax & Finance Insights"
  description="Notes on UAE Corporate Tax, financial control and the systems underneath them — written from the work, not for search engines."
>
  <PageHero
    kicker="Insights / Notes from the work"
    title="Written down once, so it can be argued with."
    lead="Short notes on the problems we keep meeting — first Corporate Tax returns, reliefs elected without counting the cost, slow closes — and a brief on what the regulators published each week."
    primary={{ label: 'Talk to us', href: '/contact/' }}
    stats={[
      { label: 'Notes published', value: String(insights.length) },
      { label: 'Topics', value: 'CT · control · systems' },
      { label: 'Latest', value: formatInsightDate(insights[0].date) },
      { label: 'Reading', value: '5–7 minutes' },
    ]}
  />

  <section class="nt-section">
    <aside class="nt-brief-callout" aria-labelledby="brief-callout-title">
      <div>
        <p class="nt-kicker">Regulation, week by week</p>
        <h2 class="nt-h3" id="brief-callout-title">{BRIEF_SERIES.name}</h2>
        <p class="nt-small">
          Each edition covers one week: what UAE tax and compliance regulators published, what it
          means for a small business, and what falls due in the next 30 days. Latest:
          {' '}{latestBrief.title.replace(/^Week/, 'week')}.
        </p>
      </div>
      <a class="nt-arrow-link" href={BRIEF_SERIES.path}>
        Read the brief
        <Arrow />
      </a>
    </aside>

    <div class="nt-cells" style="--nt-cols:2">
      {
        insights.map((insight) => (
          <article class="nt-cell">
            <div class="nt-cell__head">
              <div class="nt-kicker">{insight.topic}</div>
              <span class="nt-stage">{insight.readingMinutes} min</span>
            </div>
            <h2 class="nt-h3" style="font-size:24px">{insight.title}</h2>
            <p>{insight.summary}</p>
            <div class="nt-cell__notes">
              <div><time datetime={insight.date}>{formatInsightDate(insight.date)}</time></div>
            </div>
            <a class="nt-link" href={`/insights/${insight.slug}/`} style="margin-top:8px">Read it<span class="nt-sr-only">: {insight.title}</span></a>
          </article>
        ))
      }
    </div>
  </section>

  <NextBand
    title="Disagree with any of it?"
    body="These are positions, not neutral summaries. If your situation points the other way we would rather hear it."
    cta="Write to us"
  />
</Base>
