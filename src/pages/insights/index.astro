---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import NextBand from '../../components/NextBand.astro';
import { insightsNewestFirst, formatInsightDate } from '../../insights';

const insights = insightsNewestFirst();
---

<Base
  title="Insights"
  description="Notes on UAE Corporate Tax, financial control and the systems underneath them — written from the work, not for search engines."
  ownNav={true}
>
  <PageHero
    kicker="Insights / Notes from the work"
    title="Written down once, so it can be argued with."
    lead="Short notes on the problems we keep meeting: first Corporate Tax returns, slow closes, and audit trails treated as reports rather than requirements."
    primary={{ label: 'Talk to us', href: '/contact/' }}
    stats={[
      { label: 'Notes published', value: String(insights.length) },
      { label: 'Topics', value: 'CT · control · systems' },
      { label: 'Latest', value: formatInsightDate(insights[0].date) },
      { label: 'Reading', value: '5–7 minutes' },
    ]}
  />

  <section class="nt-section">
    <div class="nt-cells" style="--nt-cols:2">
      {
        insights.map((insight) => (
          <article class="nt-cell">
            <div class="nt-cell__head">
              <div class="nt-kicker">{insight.topic}</div>
              <span class="nt-stage">{insight.readingMinutes} min</span>
            </div>
            <h2 class="nt-h3" style="font-size:24px">{insight.title}</h2>
            <p>{insight.summary}</p>
            <div class="nt-cell__notes">
              <div><time datetime={insight.date}>{formatInsightDate(insight.date)}</time></div>
            </div>
            <a class="nt-link" href={`/insights/${insight.slug}/`} style="margin-top:8px">Read it</a>
          </article>
        ))
      }
    </div>
  </section>

  <NextBand
    title="Disagree with any of it?"
    body="These are positions, not neutral summaries. If your situation points the other way we would rather hear it."
    cta="Write to us"
  />
</Base>
