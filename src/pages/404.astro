---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { NAV } from '../consts';

const destinations = [
  ...NAV.map((item) => ({ label: item.label, href: item.href })),
  { label: 'Contact', href: '/contact/' },
];
---

<Base
  title="Page not found"
  description="That page does not exist on the NUMARATECH website."
  noindex={true}
>
  <PageHero
    kicker="Error / 404"
    title="This page does not reconcile."
    lead="The address you followed does not exist here. It may have moved, or the link may have been mistyped."
    primary={{ label: 'Back to the home page', href: '/' }}
    secondary={{ label: 'Talk to the practice', href: '/contact/' }}
    stats={destinations.slice(0, 4).map((d) => ({ label: 'Try', value: d.label }))}
  />
</Base>

