---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { NAV } from '../consts';

const destinations = [
  ...NAV.map((item) => ({ label: item.label, href: item.href })),
  { label: 'Contact', href: '/contact/' },
];
---

<Base
  title="Page not found"
  description="That page does not exist on the NUMARATECH website."
  noindex={true}
  ownNav={true}
>
  <PageHero
    kicker="Error / 404"
    title="This page does not reconcile."
    lead="The address you followed does not exist here. It may have moved, or the link may have been mistyped."
    primary={{ label: 'Back to the home page', href: '/' }}
    secondary={{ label: 'Talk to the practice', href: '/contact/' }}
    stats={destinations.slice(0, 4).map((d) => ({ label: 'Try', value: d.label }))}
  />
</Base>

<style>
  .nf {
    border-bottom: var(--nt-hair) solid var(--nt-hairline);
  }

  .inner {
    padding-block: clamp(3.5rem, 10vw, 8rem);
  }

  .title {
    margin-top: var(--nt-5);
  }

  .lead {
    margin-top: var(--nt-6);
    max-width: 48ch;
  }

  .actions {
    margin-top: var(--nt-7);
  }

  .also {
    margin-top: var(--nt-8);
    padding-top: var(--nt-4);
    border-top: var(--nt-hair) solid var(--nt-hairline);
  }

  .also__list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--nt-5);
    margin-top: var(--nt-4);
    font-size: var(--nt-fs-sm);
  }

  .also__list a {
    color: var(--nt-navy-700);
    text-decoration: none;
    border-bottom: var(--nt-hair) solid var(--nt-hairline);
  }

  .also__list a:hover {
    color: var(--nt-accent);
    border-color: var(--nt-accent-rule);
  }
</style>
