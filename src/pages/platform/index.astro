---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import SectionHead from '../../components/SectionHead.astro';
import LineDiagram from '../../components/LineDiagram.astro';
import CtaBand from '../../components/CtaBand.astro';
import Arrow from '../../components/Arrow.astro';
import { LIVE_PRODUCTS, IDEA_PRODUCTS } from '../../services';

const diagrams: Record<string, 'tax' | 'statements'> = {
  'corporate-tax': 'tax',
  'fs-studio': 'statements',
};

const foundations = [
  {
    title: 'One mapped ledger',
    body:
      'Your chart of accounts is mapped once into a structure carrying statutory presentation and tax classification at the same time. Two answers from one source, so they cannot diverge.',
  },
  {
    title: 'Lineage on every figure',
    body:
      'Each number holds a reference to the entries and adjustments that produced it. Drill from a filed figure to a journal without leaving the screen.',
  },
  {
    title: 'Period locking',
    body:
      'Once a period is filed it is frozen. Later corrections become explicit prior-period adjustments rather than silent restatements of history.',
  },
  {
    title: 'Print as an output',
    body:
      'Every computation and statement has a considered printed form, because the version that gets filed and defended is usually the paper one.',
  },
  {
    title: 'Read-only by default',
    body:
      'Connections into your accounting system are read-only unless you deliberately grant write access. We would rather compute than mutate.',
  },
  {
    title: 'Data stays where you put it',
    body:
      'UAE-region hosting, per-entity separation, and an export path that returns everything in open formats whenever you ask.',
  },
];
---

<Base
  title="Platform"
  description="The NUMARATECH platform: a live Corporate Tax Engine and FS Studio built on one mapped ledger, plus a roadmap of four products at idea stage."
>
  <PageHeader
    eyebrow="Platform"
    title="One model of your business. Several ways to use it."
    lead="Most compliance tooling treats the statements and the tax computation as separate exercises. We map your ledger once and derive both from it, which is why they agree."
    meta={[
      { label: 'Live', value: `${LIVE_PRODUCTS.length} products` },
      { label: 'Roadmap', value: `${IDEA_PRODUCTS.length} at idea stage` },
      { label: 'Ledger access', value: 'Read-only by default' },
      { label: 'Deployment', value: 'Hosted, UAE region' },
    ]}
  />

  <div class="nt-wrap"><div class="nt-ticks" aria-hidden="true"></div></div>

  <!-- Live products ------------------------------------------------------ -->
  <section class="nt-section nt-wrap">
    <SectionHead
      index="01"
      eyebrow="In production"
      title="What you can use today."
    />

    <ul class="nt-ruled products">
      {
        LIVE_PRODUCTS.map((product, i) => (
          <li class="product nt-reveal">
            <div class="product__main">
              <p class="nt-micro nt-micro-idx">
                <span class="nt-fig idx">
                  {String(i + 1).padStart(2, '0')}
                </span>
                {product.strap}
              </p>
              <h3 class="nt-h2 product__name">
                <a href={product.href}>{product.name}</a>
              </h3>
              <p class="product__text nt-lead">{product.body}</p>

              <ul class="nt-checks product__points">
                {product.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>

              <p class="product__more">
                <a href={product.href} class="nt-arrow-link">
                  Read more about {product.name}
                  <Arrow />
                </a>
              </p>
            </div>

            <LineDiagram
              variant={diagrams[product.slug]}
              class="product__diagram"
            />
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Roadmap ------------------------------------------------------------ -->
  <section class="nt-section nt-section--invert nt-reveal" id="roadmap">
    <div class="nt-wrap">
      <SectionHead
        index="02"
        eyebrow="Roadmap"
        title="What we intend to build next."
        lead="These do not exist yet. They are listed because we would rather be judged on a stated direction than imply a catalogue we do not have — and because the order is worth arguing with."
        invert={true}
      />

      <ul class="ideas">
        {
          IDEA_PRODUCTS.map((product, i) => (
            <li class="idea">
              <div class="idea__head">
                <p class="nt-micro nt-micro--invert nt-micro-idx">
                  <span class="nt-fig">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  {product.strap}
                </p>
                <h3 class="nt-h3 idea__name">
                  {product.name}
                  <span class="idea__stage">Idea stage</span>
                </h3>
              </div>

              <div>
                <p class="idea__body">{product.body}</p>
                <ul class="nt-checks idea__points">
                  {product.points.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ul>

      <p class="ideas__note">
        Nothing here is committed, dated or available to buy. If one of these
        would change how your finance function runs, that is worth a
        conversation — the order we build in should be set by the people who
        would use them.
      </p>

      <p class="ideas__cta">
        <a href="/contact/" class="nt-arrow-link">
          Tell us which one matters
          <Arrow />
        </a>
      </p>
    </div>
  </section>

  <!-- Foundations -------------------------------------------------------- -->
  <section class="nt-section nt-wrap nt-reveal">
    <SectionHead
      index="03"
      eyebrow="Foundations"
      title="Decisions that hold across everything we build."
      lead="Constraints we accepted early and have not traded away — including in the roadmap above."
    />

    <div class="nt-cols nt-cols--3 foundations">
      {
        foundations.map((item) => (
          <div>
            <span class="nt-mark" aria-hidden="true" />
            <h3 class="nt-h3 foundation__title">{item.title}</h3>
            <p class="foundation__body">{item.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Connections -------------------------------------------------------- -->
  <section class="nt-section nt-wrap nt-divide nt-reveal">
    <div class="nt-split">
      <SectionHead
        index="04"
        eyebrow="Connections"
        title="It has to work with what you already run."
      />

      <div>
        <p class="nt-lead">
          We connect to mainstream accounting systems and UAE banking exports
          rather than asking you to migrate. Where an API exists we use it;
          where it does not, we take a structured file and validate it on the
          way in.
        </p>

        <div class="nt-table-scroll connections">
          <table class="nt-table">
            <caption>Connection types</caption>
            <thead>
              <tr>
                <th scope="col">Source</th>
                <th scope="col">Method</th>
                <th scope="col">Direction</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Cloud accounting systems</td>
                <td>Vendor API</td>
                <td>Read</td>
              </tr>
              <tr>
                <td>On-premise ledgers</td>
                <td>Scheduled structured export</td>
                <td>Read</td>
              </tr>
              <tr>
                <td>Bank statements</td>
                <td>Statement file or feed</td>
                <td>Read</td>
              </tr>
              <tr>
                <td>Working papers and support</td>
                <td>Secure upload</td>
                <td>Read / write</td>
              </tr>
              <tr>
                <td>Your own reporting stack</td>
                <td>Export API, open formats</td>
                <td>Read</td>
              </tr>
            </tbody>
          </table>
        </div>

        <p class="connections__note nt-sm">
          Using something not listed here? Tell us what it is —
          <a href="/contact/">we will say honestly</a> whether we can read it
          well or not at all.
        </p>
      </div>
    </div>
  </section>

  <CtaBand
    eyebrow="Next step"
    title="See it against your own trial balance."
    body="Walkthroughs use your numbers, not a demo dataset. Thirty minutes is usually enough to know whether this fits."
  />
</Base>

<style>
  .products {
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .product {
    display: grid;
    gap: var(--nt-6);
    align-items: start;
    padding-block: var(--nt-7);
  }

  .idx {
    color: var(--nt-teal-800);
  }

  .product__name {
    margin-top: var(--nt-4);
  }

  .product__name a {
    color: var(--nt-navy-900);
    text-decoration: none;
  }

  .product__name a:hover {
    color: var(--nt-teal-800);
  }

  .product__text {
    margin-top: var(--nt-4);
    max-width: 56ch;
  }

  .product__points {
    margin-top: var(--nt-5);
    font-size: var(--nt-fs-sm);
    max-width: 52ch;
  }

  .product__more {
    margin-top: var(--nt-5);
  }

  .product__diagram {
    justify-self: start;
  }

  @media (min-width: 60rem) {
    .product {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      gap: var(--nt-7);
    }

    .product__diagram {
      justify-self: end;
      margin-top: var(--nt-6);
    }
  }

  /* -- Roadmap ---------------------------------------------------------- */
  .ideas {
    list-style: none;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    border-top: var(--nt-hair) solid var(--nt-teal-500);
  }

  .idea {
    display: grid;
    gap: var(--nt-4);
    align-items: start;
    padding-block: var(--nt-6);
    border-bottom: var(--nt-hair) solid rgb(255 255 255 / 0.14);
  }

  .idea__name {
    margin-top: var(--nt-3);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--nt-3);
  }

  /* A stated stage, not a badge — square, hairline, no fill. */
  .idea__stage {
    border: var(--nt-hair) solid var(--nt-teal-500);
    padding: 2px var(--nt-2);
    color: var(--nt-teal-500);
    font-family: var(--nt-font-mono);
    font-size: var(--nt-fs-micro);
    font-weight: 500;
    letter-spacing: var(--nt-tr-micro);
    text-transform: uppercase;
  }

  .idea__body {
    color: var(--nt-line-300);
    max-width: 58ch;
  }

  .idea__points {
    margin-top: var(--nt-4);
    font-size: var(--nt-fs-sm);
    color: var(--nt-line-300);
    max-width: 52ch;
  }

  .ideas__note {
    margin-top: var(--nt-6);
    color: var(--nt-line-300);
    font-size: var(--nt-fs-sm);
    max-width: 64ch;
  }

  .ideas__cta {
    margin-top: var(--nt-5);
  }

  @media (min-width: 60rem) {
    .idea {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      gap: var(--nt-7);
    }
  }

  /* -- Foundations and connections -------------------------------------- */
  .foundations {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .foundation__title {
    margin-top: var(--nt-4);
  }

  .foundation__body {
    margin-top: var(--nt-3);
    font-size: var(--nt-fs-sm);
    max-width: 44ch;
  }

  .connections {
    margin-top: var(--nt-6);
  }

  .connections__note {
    margin-top: var(--nt-5);
    color: var(--nt-text-muted);
    max-width: 56ch;
  }
</style>
