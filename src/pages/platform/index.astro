---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import NextBand from '../../components/NextBand.astro';
import CtConsole from '../../components/CtConsole.astro';
import FsConsole from '../../components/FsConsole.astro';
import { BUILT_PRODUCTS, IDEA_PRODUCTS } from '../../services';
---

<Base
  title="Platform"
  description="The tooling NUMARATECH files with, licensed to firms and finance functions: a Corporate Tax Engine and FS Studio, both reading one mapped ledger."
>
  <PageHero
    kicker="Platform / Software licensed to firms and finance functions"
    title="It computes and it evidences. It does not decide."
    lead="The tooling our own team files with, licensed to other firms and finance functions. Judgement stays with your people — the platform's job is to make every figure derivable and every derivation durable."
    primary={{ label: 'Book a walkthrough', href: '/contact/' }}
    secondary={{ label: 'See what is next', href: '#roadmap' }}
    stats={[
      { label: 'Live products', value: 'two' },
      { label: 'Shared model', value: 'one mapped ledger' },
      { label: 'Ledger access', value: 'read-only' },
      { label: 'Roadmap', value: `${IDEA_PRODUCTS.length} at idea stage`, live: true },
    ]}
  />

  <section class="nt-section">
    <div class="nt-eyebrow"><b>01</b><span>Live now</span></div>
    <h2 class="nt-h2">Two products in private beta.</h2>
    <p class="nt-body">
      Both read the same mapped ledger, so the statements and the tax computation cannot disagree
      with each other.
    </p>

    <div class="nt-split" style="margin-bottom:56px">
      <div style="display:flex; flex-direction:column; gap:14px">
        <div class="nt-kicker">{BUILT_PRODUCTS[0].strap}</div>
        <h3 class="nt-h2" style="font-size:30px; margin-bottom:0">{BUILT_PRODUCTS[0].name}</h3>
        <p class="nt-small">{BUILT_PRODUCTS[0].body}</p>
        <ul class="nt-rail">{BUILT_PRODUCTS[0].points.map((point) => <li>{point}</li>)}</ul>
        <a class="nt-link" href="/platform/corporate-tax/" style="margin-top:12px">
          Corporate Tax Engine in full
        </a>
      </div>
      <CtConsole />
    </div>

    <div class="nt-split">
      <div style="display:flex; flex-direction:column; gap:14px">
        <div class="nt-kicker">{BUILT_PRODUCTS[1].strap}</div>
        <h3 class="nt-h2" style="font-size:30px; margin-bottom:0">{BUILT_PRODUCTS[1].name}</h3>
        <p class="nt-small">{BUILT_PRODUCTS[1].body}</p>
        <ul class="nt-rail">{BUILT_PRODUCTS[1].points.map((point) => <li>{point}</li>)}</ul>
        <a class="nt-link" href="/platform/fs-studio/" style="margin-top:12px">FS Studio in full</a>
      </div>
      <FsConsole />
    </div>
  </section>

  <section class="nt-section nt-dark nt-section--flush">
    <div class="nt-grid--v"></div>
    <div class="nt-layer">
      <div class="nt-eyebrow"><b>02</b><span>The shared model</span></div>
      <h2 class="nt-h2">Mapped once, read by everything.</h2>
      <p class="nt-body">
        Your chart of accounts is mapped once to a structure that can carry both a statutory
        statement and a tax computation. Every product downstream reads that one mapping.
      </p>
      <div class="nt-cells nt-cells--4" style="--nt-cols:4">
        <div class="nt-cell">
          <div class="nt-cell__num">01</div>
          <h3 class="nt-h3">Connect</h3>
          <p>Read-only connections to your accounting system and banks. Nothing is retyped, so nothing drifts.</p>
        </div>
        <div class="nt-cell">
          <div class="nt-cell__num">02</div>
          <h3 class="nt-h3">Normalise</h3>
          <p>
            One mapping carries both the statutory statement and the tax computation, instead of two
            sets of judgement that quietly stop agreeing.
          </p>
        </div>
        <div class="nt-cell">
          <div class="nt-cell__num">03</div>
          <h3 class="nt-h3">Compute</h3>
          <p>
            Statements and the tax position are derived, not assembled by hand. Every figure keeps a
            link back to the entries behind it.
          </p>
        </div>
        <div class="nt-cell">
          <div class="nt-cell__num">04</div>
          <h3 class="nt-h3">File and defend</h3>
          <p>
            Submit with the working papers already attached. When a question arrives eighteen months
            later, the answer is still in the file.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="nt-section" id="roadmap">
    <div class="nt-eyebrow"><b>03</b><span>Roadmap · idea stage</span></div>
    <h2 class="nt-h2">{IDEA_PRODUCTS.length} we intend to build.</h2>
    <p class="nt-body">
      These do not exist yet and are not available to buy. We list them so the direction is arguable.
    </p>
    <div class="nt-cells" style="--nt-cols:2">
      {
        IDEA_PRODUCTS.map((product) => (
          <div class="nt-cell">
            <div class="nt-cell__head">
              <h3 class="nt-h3">{product.name}</h3>
              <span class="nt-stage">{product.stage}</span>
            </div>
            <div class="nt-kicker">{product.strap}</div>
            <p>{product.body}</p>
            <div class="nt-cell__notes">
              {product.points.map((point) => <div>{point}</div>)}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <NextBand
    title="See it on your own trial balance."
    body="A 30-minute walkthrough, your numbers on screen. We will tell you plainly whether the platform fits how you work — and what it would take."
  />
</Base>
