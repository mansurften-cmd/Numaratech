---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import NextBand from '../../components/NextBand.astro';
import FsConsole from '../../components/FsConsole.astro';
import { PRODUCTS } from '../../services';

const product = PRODUCTS.find((p) => p.slug === 'fs-studio')!;
---

<Base title={product.name} description={product.body} ownNav={true}>
  <PageHero
    kicker="Platform / FS Studio"
    title="Statements derived, not retyped."
    lead={product.body}
    primary={{ label: 'See it on your numbers', href: '/contact/' }}
    secondary={{ label: 'Corporate Tax Engine', href: '/platform/corporate-tax/' }}
    stats={[
      { label: 'Stage', value: 'live', live: true },
      { label: 'Presentation', value: 'IFRS · IFRS for SMEs' },
      { label: 'Source', value: 'mapped ledger' },
      { label: 'Comparatives', value: 'locked to prior filing' },
    ]}
  />

  <section class="nt-section">
    <div class="nt-eyebrow"><b>01</b><span>The screen</span></div>
    <h2 class="nt-h2">Change a mapping, and the notes move with it.</h2>
    <p class="nt-body">
      A statement built by hand disagrees with the ledger the moment either one changes. Here the
      statements and the notes are outputs of the mapping, so they cannot drift apart.
    </p>

    <div class="nt-split">
      <div style="display:flex; flex-direction:column; gap:14px">
        <div class="nt-kicker">{product.strap}</div>
        <ul class="nt-rail">
          {product.points.map((point) => <li>{point}</li>)}
        </ul>
      </div>
      <FsConsole />
    </div>
    <p style="margin:20px 0 0; font-size:12.5px; color:var(--nt-mute)">Illustrative figures.</p>
  </section>

  <section class="nt-section nt-dark nt-section--flush">
    <div class="nt-grid--v"></div>
    <div class="nt-layer">
      <div class="nt-eyebrow"><b>02</b><span>What it produces</span></div>
      <h2 class="nt-h2">A full set, and the reason behind each figure.</h2>
      <p class="nt-body">
        The four primary statements and the notes, with every balance still linked to the accounts it
        came from.
      </p>
      <div class="nt-cells nt-cells--4" style="--nt-cols:4">
        <div class="nt-cell">
          <div class="nt-cell__num">01</div>
          <h3 class="nt-h3">Primary statements</h3>
          <p>Profit or loss, financial position, changes in equity and cash flows in one set.</p>
        </div>
        <div class="nt-cell">
          <div class="nt-cell__num">02</div>
          <h3 class="nt-h3">Notes that recompute</h3>
          <p>Disclosure notes are generated from the same mapping, not maintained beside it.</p>
        </div>
        <div class="nt-cell">
          <div class="nt-cell__num">03</div>
          <h3 class="nt-h3">Locked comparatives</h3>
          <p>Prior year figures are held to the position actually filed, and flagged if they move.</p>
        </div>
        <div class="nt-cell">
          <div class="nt-cell__num">04</div>
          <h3 class="nt-h3">Audit-ready export</h3>
          <p>A signed set exported with the derivation of each balance available underneath it.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="nt-section">
    <div class="nt-eyebrow"><b>03</b><span>With the tax engine</span></div>
    <h2 class="nt-h2">One mapping under both.</h2>
    <p class="nt-body">
      FS Studio and the Corporate Tax Engine read the same mapped ledger, so the statements and the
      computation cannot disagree with each other.
    </p>
    <a class="nt-link" href="/platform/corporate-tax/">Corporate Tax Engine</a>
  </section>

  <NextBand
    title="See your last set, rebuilt."
    body="Send us a trial balance and a prior year set. We will show you the same statements derived from the mapping, and where the two differ."
  />
</Base>
