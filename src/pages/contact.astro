---
/** /contact/ — Web3Forms form when an access key is present, direct details
 *  otherwise (a visible gap rather than a form that discards enquiries). */
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { SITE, WEB3FORMS, hasContactForm } from '../consts';

// Surfaced in the build log so a deploy without a key is noticed. Deliberately
// a warning and not a thrown error: failing the build would take the entire
// site offline on every Cloudflare deploy over a form that has a working
// email fallback, which trades a small gap for a total outage.
if (!hasContactForm()) {
  console.warn(
    '[contact] No Web3Forms access key set — /contact/ is shipping the email fallback. ' +
      'Set WEB3FORMS.accessKey in src/consts.ts to switch the form on.'
  );
}
---

<Base
  title="Contact"
  seoTitle="Contact Our Dubai Accounting & Tax Team"
  description="Talk to NUMARATECH about advisory work or the platform. Dubai, United Arab Emirates."
>
  <PageHero
    kicker="Contact / Dubai"
    title="Tell us what is due, and when."
    lead="Bring your year end, your licence type and whatever is currently unresolved. A 30-minute call is usually enough to tell you what needs doing and what it costs."
    stats={[
      { label: 'Email', value: SITE.email },
      { label: 'Telephone', value: SITE.phoneDisplay },
      { label: 'Based in', value: `${SITE.address.city}, ${SITE.address.country}` },
      { label: 'Response', value: 'one business day' },
    ]}
  />

  <section class="nt-section">
    <div class="nt-split--even nt-split">
      <div>
        <div class="nt-eyebrow"><b>01</b><span>Direct</span></div>
        <h2 class="nt-h2">Write, or call.</h2>
        <p class="nt-body">
          Either reaches the same three people. If your question is specific, send the detail — it
          saves a round trip.
        </p>
        <div class="nt-footer__meta" style="color:var(--nt-ink)">
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a><br />
          <a href={`tel:${SITE.phoneHref}`}>{SITE.phoneDisplay}</a><br />
          {SITE.address.city}, {SITE.address.country}
        </div>
      </div>

      <div>
        <div class="nt-eyebrow"><b>02</b><span>Enquiry</span></div>
        {
          hasContactForm() ? (
            <form class="nt-form" action={WEB3FORMS.endpoint} method="POST">
              <input type="hidden" name="access_key" value={WEB3FORMS.accessKey} />
              <input type="hidden" name="subject" value={WEB3FORMS.subject} />
              <!-- Web3Forms otherwise lands the visitor on its own success
                   page, off-site. This brings them back to ours. -->
              <input type="hidden" name="redirect" value={`${SITE.url}/contact/sent/`} />
              <!-- Honeypot: a field people never see and bots fill in. -->
              <input type="checkbox" name="botcheck" class="nt-form__trap" tabindex="-1" aria-hidden="true" />

              <label class="nt-form__field">
                <span class="nt-kicker">Name</span>
                <input class="nt-form__input" required name="name" type="text" autocomplete="name" />
              </label>
              <label class="nt-form__field">
                <span class="nt-kicker">Email</span>
                <input class="nt-form__input" required name="email" type="email" autocomplete="email" inputmode="email" />
              </label>
              <label class="nt-form__field">
                <span class="nt-kicker">What do you need?</span>
                <textarea class="nt-form__input" required name="message" rows="5"></textarea>
              </label>
              <button class="nt-btn" type="submit" style="align-self:flex-start">Send enquiry</button>
              <p class="nt-form__note">
                Delivered by Web3Forms to our mailbox and used only to answer you. We do not add
                you to a list. How we handle what you send is in the
                <a href="/privacy/">privacy notice</a>.
              </p>
            </form>
          ) : (
            <div style="border:1px solid var(--nt-navy); padding:24px 26px; max-width:34em">
              <div class="nt-kicker" style="margin-bottom:10px">By email</div>
              <p class="nt-small" style="margin:0 0 18px">
                Write to us directly rather than through a form. Tell us your year end, your licence
                type and what is currently unresolved — that is enough for us to come back with
                something useful rather than a request for more detail.
              </p>
              <div class="nt-actions">
                <a class="nt-btn" href={`mailto:${SITE.email}`}>Email us</a>
                <a class="nt-link" href={`tel:${SITE.phoneHref}`}>{SITE.phoneDisplay}</a>
              </div>
            </div>
          )
        }
      </div>
    </div>
  </section>
</Base>
