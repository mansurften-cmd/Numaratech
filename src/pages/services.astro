---
/** /services/ — platform implementation and support. Distinct from the
 *  advisory practice; cross-links so neither audience lands in the wrong
 *  place. Copy carried over from the previous build unchanged. */
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import NextBand from '../components/NextBand.astro';

const services = [
  {
    name: 'Implementation',
    line: 'Four to eight weeks, one period proven',
    body:
      'We map your chart of accounts, connect your ledger, build your adjustment library, and run one closed period end to end alongside your existing process. You compare the two before anything is switched over.',
    points: [
      'Chart of accounts mapped for statutory and tax presentation',
      'Read-only connections established and validated',
      'Adjustment library built from your actual prior computations',
      'One historical period reproduced and reconciled',
    ],
  },
  {
    name: 'Data remediation',
    line: 'Before the system, the data',
    body:
      'Most implementations stall on the ledger, not the software. Where the underlying data will not support a defensible computation, we fix that first — and tell you plainly if it is the larger part of the job.',
    points: [
      'Chart of accounts rationalised, not just renamed',
      'Historic bank activity classified and reconciled',
      'Opening balances agreed to the last filed position',
      'Gaps documented where evidence genuinely no longer exists',
    ],
  },
  {
    name: 'Process automation',
    line: 'The work that should not need a person',
    body:
      'Recurring finance work built into something repeatable: bank classification, intercompany matching, schedule preparation, management reporting packs. Judgement stays with your people; the mechanical parts do not.',
    points: [
      'Bank transaction classification with a rule set you own',
      'Intercompany matching and elimination workflows',
      'Recurring management reporting on a schedule',
      'Exception queues instead of full manual review',
    ],
  },
  {
    name: 'Ongoing support',
    line: 'Someone who knows your file',
    body:
      'Named support from people who have seen your ledger, not a queue. Regime changes are applied to your configuration by us, with a note explaining what changed and what it did to your numbers.',
    points: [
      'Named contact familiar with your entities',
      'Regulatory changes applied and explained',
      'Quarterly review of mappings and adjustments',
      'Support during audit and any FTA correspondence',
    ],
  },
];

const phases = [
  {
    when: 'Week 1',
    title: 'Look at the ledger',
    body:
      'We take a read-only copy and assess whether it can support a computation. You get a written view of what needs fixing before any configuration starts.',
  },
  {
    when: 'Weeks 2–3',
    title: 'Map and connect',
    body:
      'Chart of accounts mapped for both statutory and tax presentation. Connections established. Your adjustment library built from what you actually did last year.',
  },
  {
    when: 'Weeks 4–6',
    title: 'Reproduce a period',
    body:
      'We rebuild a period you have already closed and reconcile to it line by line. Differences are explained, not smoothed. This is the part that tells you whether it works.',
  },
  {
    when: 'Weeks 7–8',
    title: 'Hand over',
    body:
      'Your team runs the next close, with us alongside rather than doing it. Training is the close itself; there is no separate course.',
  },
];

const principles = [
  {
    title: 'We will tell you if it is not worth doing',
    body:
      'Some finance functions do not need us. If a spreadsheet genuinely serves you and the risk is low, we will say so on the first call rather than sell you a programme.',
  },
  {
    title: 'Scope is fixed, or it is not scope',
    body:
      'Implementation is quoted as a fixed piece of work against a written definition of done. If the ledger turns out to be worse than it looked, we re-quote before doing the extra work, not after.',
  },
  {
    title: 'You keep your data',
    body:
      'Export is a first-class feature, not a retention lever. Everything you put in comes back out in open formats, on request, at any point — including after you leave.',
  },
  {
    title: 'Your team does the judgement',
    body:
      'We automate the mechanical and leave the judgement where it belongs. A system that makes tax positions on your behalf is a liability, not a product.',
  },
];
---

<Base
  title="Implementation and support"
  description="Getting the NUMARATECH platform running on your ledger: implementation, data remediation, process automation and ongoing support. Fixed scope, one period proven before you switch over."
  ownNav={true}
>
  <PageHero
    kicker="Platform / Implementation and support"
    title="Licensing the software is the easy part."
    lead="A platform is worth nothing sitting on top of a ledger that cannot support it. This is the work that makes the software able to tell the truth — separate from the advisory practice, and available whether or not you use it."
    primary={{ label: 'Book a walkthrough', href: '/contact/' }}
    secondary={{ label: 'The advisory practice', href: '/advisory/' }}
    stats={[
      { label: 'Implementation', value: 'four to eight weeks' },
      { label: 'Commercials', value: 'fixed scope, quoted in writing' },
      { label: 'Proof', value: 'one historical period' },
      { label: 'Exit', value: 'full export, open formats' },
    ]}
  />

  <section class="nt-section">
    <div class="nt-eyebrow"><b>01</b><span>Engagements</span></div>
    <h2 class="nt-h2">Four ways we work.</h2>
    <p class="nt-body">
      Most clients start with implementation. A meaningful minority need remediation first, and we
      will say so before quoting anything else. These are platform engagements — if what you want is
      someone to take the position and file, that is the
      <a class="nt-link" href="/advisory/">advisory practice</a>.
    </p>

    {
      services.map((service, i) => (
        <article class="nt-service">
          <div class="nt-service__head">
            <div class="nt-service__idx">{String(i + 1).padStart(2, '0')}</div>
            <h3 class="nt-h2" style="font-size:30px; margin-bottom:6px">{service.name}</h3>
            <div class="nt-kicker">{service.line}</div>
          </div>
          <div>
            <p class="nt-body" style="margin-bottom:20px">{service.body}</p>
            <ul class="nt-points">
              {service.points.map((point) => <li>{point}</li>)}
            </ul>
          </div>
        </article>
      ))
    }
  </section>

  <section class="nt-section nt-dark nt-dark--navy nt-section--flush">
    <div class="nt-grid--v"></div>
    <div class="nt-layer">
      <div class="nt-eyebrow"><b>02</b><span>Sequence</span></div>
      <h2 class="nt-h2">How an implementation actually runs.</h2>
      <p class="nt-body">
        No discovery phase that produces a document nobody reads. We start on your real ledger in the
        first week.
      </p>
      <div class="nt-cells nt-cells--4" style="--nt-cols:4">
        {
          phases.map((phase, i) => (
            <div class="nt-cell">
              <div class="nt-cell__num">{String(i + 1).padStart(2, '0')}</div>
              <div class="nt-kicker">{phase.when}</div>
              <h3 class="nt-h3">{phase.title}</h3>
              <p>{phase.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="nt-section">
    <div class="nt-eyebrow"><b>03</b><span>How we engage</span></div>
    <h2 class="nt-h2">Four commitments.</h2>
    <p class="nt-body">
      These constrain us more than they constrain you. That is the point of writing them down.
    </p>
    <div class="nt-cells" style="--nt-cols:2">
      {
        principles.map((principle) => (
          <div class="nt-cell">
            <h3 class="nt-h3">{principle.title}</h3>
            <p>{principle.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <NextBand
    title="Start with the ledger review."
    body="Before any quote, we look at your actual data and tell you what state it is in. That conversation is useful even if you never become a client."
  />
</Base>
