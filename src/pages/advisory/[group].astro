---
/** The three advisory group pages: /advisory/accounting-audit/, /tax/,
 *  /risk-compliance/. Each carries its services as anchored sections. */
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import NextBand from '../../components/NextBand.astro';
import { SERVICE_GROUPS } from '../../services';

export function getStaticPaths() {
  return SERVICE_GROUPS.map((group) => ({
    params: { group: group.slug },
    props: { group },
  }));
}

const { group } = Astro.props;
---

<Base title={group.name} description={group.lead} ownNav={true}>
  <PageHero
    kicker={`Advisory / ${group.name}`}
    title={group.name}
    lead={group.lead}
    primary={{ label: 'Book a walkthrough', href: '/contact/' }}
    secondary={{ label: 'All advisory', href: '/advisory/' }}
    stats={[
      { label: 'Service lines', value: String(group.services.length) },
      { label: 'Covers', value: group.strap },
      { label: 'Delivery', value: 'fixed fee where knowable' },
      { label: 'Jurisdiction', value: 'United Arab Emirates' },
    ]}
  />

  <section class="nt-section">
    <div class="nt-eyebrow"><b>01</b><span>In this group</span></div>
    <h2 class="nt-h2">{group.services.length} service lines.</h2>
    <ul class="nt-jump">
      {
        group.services.map((service) => (
          <li>
            <a href={`#${service.slug}`}>
              {service.name}
              <span>{service.strap}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="nt-section">
    {
      group.services.map((service, i) => (
        <article class="nt-service" id={service.slug}>
          <div class="nt-service__head">
            <div class="nt-service__idx">{String(i + 1).padStart(2, '0')}</div>
            <h3 class="nt-h2" style="font-size:30px; margin-bottom:6px">{service.name}</h3>
            <div class="nt-kicker">{service.strap}</div>
          </div>
          <div>
            <p class="nt-body" style="margin-bottom:20px">{service.body}</p>
            <ul class="nt-points">
              {service.points.map((point) => <li>{point}</li>)}
            </ul>
          </div>
        </article>
      ))
    }
  </section>

  <NextBand
    title={`Talk to us about ${group.name.toLowerCase()}.`}
    body="A 30-minute call, no obligation. We will tell you what the work involves, what it costs, and what we need from you to start."
  />
</Base>
