---
/** The three advisory group pages: /advisory/accounting-audit/, /tax/,
 *  /risk-compliance/. Each carries its services as anchored sections. */
import Base from '../../layouts/Base.astro';
import { SITE, spell, bookingHref } from '../../consts';
import PageHero from '../../components/PageHero.astro';
import NextBand from '../../components/NextBand.astro';
import Arrow from '../../components/Arrow.astro';
import { SERVICE_GROUPS } from '../../services';
import { keyServicesFor, keyServicePath, feeSummary } from '../../key-services';

export function getStaticPaths() {
  return SERVICE_GROUPS.map((group) => ({
    params: { group: group.slug },
    props: { group },
  }));
}

const { group } = Astro.props;

// Meta description under 160 characters: as many service lines as fit, with
// a count for the rest. The lead is the hero's, and runs longer.
const names = group.services.map((service) => service.name);
const describe = (n: number) => {
  const rest = names.length - n;
  return `${group.name} in Dubai, UAE: ${names.slice(0, n).join(', ')}${rest > 0 ? ` and ${rest} more service line${rest > 1 ? 's' : ''}` : ''}.`;
};
let shown = names.length;
while (shown > 1 && describe(shown).length > 160) shown--;
const description = describe(shown);

// One schema.org Service per service line, each tied to the business by @id.
const pageUrl = new URL(Astro.url.pathname, SITE.url).href;
const serviceSchema = group.services.map((service) => ({
  '@type': 'Service',
  '@id': `${pageUrl}#${service.slug}`,
  name: service.name,
  serviceType: service.name,
  description: service.body,
  url: `${pageUrl}#${service.slug}`,
  provider: { '@id': `${SITE.url}/#organisation` },
  areaServed: { '@type': 'Country', name: 'United Arab Emirates', identifier: 'AE' },
}));
---

<Base title={group.name} seoTitle={group.seoTitle} description={description} schema={serviceSchema}>
  <PageHero
    kicker={`Advisory / ${group.name}`}
    title={group.name}
    lead={group.lead}
    primary={{ label: 'Book a walkthrough', href: bookingHref() }}
    secondary={{ label: 'All advisory', href: '/advisory/' }}
    stats={[
      { label: 'Service lines', value: String(group.services.length) },
      { label: 'Covers', value: group.strap },
      { label: 'Delivery', value: 'fixed fee where knowable' },
      { label: 'Jurisdiction', value: 'United Arab Emirates' },
    ]}
  />

  <section class="nt-section">
    <div class="nt-eyebrow"><b>01</b><span>In this group</span></div>
    <h2 class="nt-h2">{spell(group.services.length, true)} service lines.</h2>
    <ul class="nt-jump">
      {
        group.services.map((service) => (
          <li>
            <a href={`#${service.slug}`}>
              {service.name}
              <span>{service.strap}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="nt-section">
    {
      group.services.map((service, i) => (
        <article class="nt-service" id={service.slug}>
          <div class="nt-service__head">
            <div class="nt-service__idx">{String(i + 1).padStart(2, '0')}</div>
            <h3 class="nt-h2" style="font-size:30px; margin-bottom:6px">{service.name}</h3>
            <div class="nt-kicker">{service.strap}</div>
          </div>
          <div>
            <p class="nt-body" style="margin-bottom:20px">{service.body}</p>
            <ul class="nt-points">
              {service.points.map((point) => <li>{point}</li>)}
            </ul>
            {keyServicesFor(group.slug, service.slug).length > 0 && (
              <ul class="nt-svc__deeplinks">
                {keyServicesFor(group.slug, service.slug).map((page) => (
                  <li>
                    <a class="nt-arrow-link" href={keyServicePath(page)}>
                      {page.name}: {feeSummary(page)}
                      <Arrow />
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </article>
      ))
    }
  </section>

  <NextBand
    title={`Talk to us about ${group.name.toLowerCase()}.`}
    body="A 30-minute call, no obligation. We will tell you what the work involves, what it costs, and what we need from you to start."
  />
</Base>
