---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import NextBand from '../../components/NextBand.astro';
import { SERVICE_GROUPS, ALL_SERVICES } from '../../services';
---

<Base
  title="Advisory"
  description="NUMARATECH advisory: accounting and audit, tax, and risk and compliance for UAE business. Licensed practice, seventeen service lines, one team."
>
  <PageHero
    kicker="Advisory / The licensed practice"
    title="Judgement, on the record."
    lead="Three practice groups, one team. Where a position has to be taken, we take it deliberately and write down why — so the reasoning is still in the file when a question arrives eighteen months later."
    primary={{ label: 'Book a walkthrough', href: '/contact/' }}
    secondary={{ label: 'See the platform', href: '/platform/' }}
    stats={[
      { label: 'Practice groups', value: 'three' },
      { label: 'Service lines', value: String(ALL_SERVICES.length) },
      { label: 'Licence', value: 'Dubai DET e-Trader' },
      { label: 'Jurisdiction', value: 'United Arab Emirates' },
    ]}
  />

  <section class="nt-section">
    <div class="nt-eyebrow"><b>01</b><span>The three groups</span></div>
    <h2 class="nt-h2">Grouped the way the work actually runs.</h2>
    <p class="nt-body">
      Books and audit support in one group, tax positions in the second, and the obligations that
      carry real penalties in the third. Each group page carries its services in full.
    </p>

    <div class="nt-cells nt-cells--3" style="--nt-cols:3">
      {
        SERVICE_GROUPS.map((group, i) => (
          <div class="nt-cell">
            <div class="nt-cell__num">{String(i + 1).padStart(2, '0')}</div>
            <h3 class="nt-h3">{group.name}</h3>
            <div class="nt-kicker">{group.strap}</div>
            <p>{group.lead}</p>
            <div class="nt-cell__notes">
              {group.services.map((service) => <div>{service.name}</div>)}
            </div>
            <a class="nt-link" href={`/advisory/${group.slug}/`} style="margin-top:8px">
              {group.name} in full
            </a>
          </div>
        ))
      }
    </div>
  </section>

  <section class="nt-section nt-dark nt-dark--navy nt-section--flush">
    <div class="nt-grid--v"></div>
    <div class="nt-layer">
      <div class="nt-eyebrow"><b>02</b><span>How we work</span></div>
      <h2 class="nt-h2">Advisory when you need judgement. Software when you need it repeatable.</h2>
      <p class="nt-body">
        The same team builds the platform our own filings run through. What can be made mechanical
        is made mechanical; what needs a position taken gets a person who will sign it.
      </p>
      <div class="nt-cells nt-cells--3" style="--nt-cols:3">
        <div class="nt-cell">
          <div class="nt-cell__num">01</div>
          <h3 class="nt-h3">Scope in plain terms</h3>
          <p>What we will do, what it costs, and what we need from you. Fixed fees where the work is knowable.</p>
        </div>
        <div class="nt-cell">
          <div class="nt-cell__num">02</div>
          <h3 class="nt-h3">Fix the ledger first</h3>
          <p>Most filing problems are upstream. A chart of accounts that can carry a computation is cheaper than a remediation.</p>
        </div>
        <div class="nt-cell">
          <div class="nt-cell__num">03</div>
          <h3 class="nt-h3">Leave the evidence behind</h3>
          <p>Every position documented as it is taken, with the workings attached to the figure they support.</p>
        </div>
      </div>
    </div>
  </section>

  <NextBand
    title="Tell us what is due, and when."
    body="A 30-minute call. Bring your year end, your licence type and whatever is currently unresolved — we will tell you plainly what needs doing and what it costs."
  />
</Base>
