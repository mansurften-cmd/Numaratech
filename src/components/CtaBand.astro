---
import Arrow from './Arrow.astro';
import { SITE } from '../consts';

interface Props {
  eyebrow?: string;
  title?: string;
  body?: string;
  /**
   * Whether this band carries the page's solid navy button. Set false on any
   * page that already spends its one solid navy element elsewhere — the home
   * hero, for instance.
   */
  primary?: boolean;
}

const {
  eyebrow = 'Next step',
  title = 'Bring us your closing process.',
  body = 'A 30-minute walkthrough, your numbers on screen. We will tell you plainly whether NUMARATECH is the right fit — and what it would take.',
  primary = true,
} = Astro.props;
---

<!-- Inset rather than navy: the site footer is already navy, and two navy
     grounds stacked would merge into one mass. -->
<section class="nt-section nt-section--inset band">
  <div class="nt-wrap inner">
    <div>
      <p class="nt-micro nt-micro--accent nt-micro-idx">{eyebrow}</p>
      <h2 class="nt-h2 title">{title}</h2>
      <p class="nt-lead body">{body}</p>
    </div>

    <div class="side">
      <a
        href="/contact/"
        class:list={['nt-btn', primary ? 'nt-btn--primary' : 'nt-btn--ghost']}
      >
        Book a walkthrough
        <Arrow class="nt-btn__arrow" />
      </a>
      <p class="nt-sm direct">
        Or write to us directly at
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
      </p>
    </div>
  </div>
</section>

<style>
  .band {
    border-top: var(--nt-hair) solid var(--nt-accent-rule);
  }

  .inner {
    display: grid;
    gap: var(--nt-6);
    align-items: end;
  }

  .title {
    margin-top: var(--nt-4);
    max-width: 26ch;
  }

  .body {
    margin-top: var(--nt-4);
    max-width: 52ch;
  }

  .side {
    display: grid;
    gap: var(--nt-4);
    justify-items: start;
  }

  .direct {
    color: var(--nt-text-muted);
    max-width: 34ch;
  }

  @media (min-width: 60rem) {
    .inner {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      gap: var(--nt-8);
    }
  }
</style>
