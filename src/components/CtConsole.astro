---
/** Corporate Tax Engine — the computation screen, drawn in hairlines.
 *  Illustrative figures; not a live product screenshot. */
---

<div class="nt-console">
  <div class="nt-console__bar">
    <span>Corporate Tax Engine — computation</span>
    <span><i class="nt-pulse" style="background:var(--nt-teal-pale)"></i>FY 2025 · Entity 01</span>
  </div>
  <div class="nt-console__body" style="grid-template-columns:150px 1fr 190px">
    <div class="nt-console__nav">
      <div>Trial balance</div>
      <div class="is-on">Adjustments</div>
      <div>Computation</div>
      <div>Working papers</div>
      <div>File</div>
    </div>

    <div class="nt-console__main">
      <div class="nt-row nt-row--head" style="grid-template-columns:1fr 92px 60px">
        <span>Adjustment</span><span class="nt-num">AED</span><span class="nt-num">Trail</span>
      </div>
      <div class="nt-row" style="grid-template-columns:1fr 92px 60px">
        <span>Entertainment — 50% disallowed</span>
        <span class="nt-num">32,400</span>
        <span style="text-align:right"><i class="nt-trail">JE-114</i></span>
      </div>
      <div class="nt-row" style="grid-template-columns:1fr 92px 60px">
        <span>Depreciation — accounting vs tax</span>
        <span class="nt-num">18,750</span>
        <span style="text-align:right"><i class="nt-trail">JE-207</i></span>
      </div>
      <div class="nt-row" style="grid-template-columns:1fr 92px 60px">
        <span>Provision — not yet incurred</span>
        <span class="nt-num">15,000</span>
        <span style="text-align:right"><i class="nt-trail">JE-291</i></span>
      </div>
      <div class="nt-row" style="grid-template-columns:1fr 92px 60px">
        <span>Interest — cap not exceeded</span>
        <span class="nt-num nt-num--mute">—</span>
        <span style="text-align:right"><i class="nt-trail nt-trail--off">n/a</i></span>
      </div>
      <div class="nt-row nt-row--total" style="grid-template-columns:1fr 92px 60px">
        <span>Total adjustments</span><span class="nt-num">66,150</span><span></span>
      </div>
    </div>

    <div class="nt-console__side">
      <h4>Position</h4>
      <div class="nt-figure">
        <span>Taxable income</span>
        <span>1,316,150</span>
      </div>
      <div class="nt-figure nt-figure--lead">
        <span>Corporate Tax at 9%</span>
        <span>84,704</span>
      </div>
      <div style="margin-top:auto; display:flex; flex-direction:column; gap:8px">
        <div style="display:flex; align-items:center; gap:8px; font-size:11.5px; color:var(--nt-navy)">
          <i style="width:5px; height:5px; background:var(--nt-teal); display:block"></i>4 of 4 lines evidenced
        </div>
        <div class="nt-console__cta" style="margin-top:0">Generate return pack</div>
      </div>
    </div>
  </div>
</div>
