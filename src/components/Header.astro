---
import { NAV } from '../consts';
import Wordmark from './Wordmark.astro';
import Arrow from './Arrow.astro';

const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="nt-site-header">
  <div class="nt-wrap bar">
    <a href="/" class="brand" aria-label="NUMARATECH — home">
      <Wordmark />
    </a>

    <nav class="nav" aria-label="Primary">
      <ul class="nav__list">
        {
          NAV.map((item) => (
            <li class:list={['nav__item', item.children && 'has-menu']}>
              <a
                href={item.href}
                class="nav__link"
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>

              {item.children && (
                <div class="menu">
                  <ul class="menu__list">
                    {item.children.map((child) => (
                      <li>
                        <a href={child.href} class="menu__link">
                          <span class="menu__label">{child.label}</span>
                          {child.note && (
                            <span class="menu__note">{child.note}</span>
                          )}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="actions">
      <a href="/contact/" class="nt-btn nt-btn--ghost cta">
        Book a walkthrough
        <Arrow class="nt-btn__arrow" />
      </a>

      <button
        type="button"
        class="nt-nav-toggle"
        aria-expanded="false"
        aria-controls="nt-mobile-nav"
        data-nav-toggle
      >
        <span class="nt-sr-only">Menu</span>
        <span class="nt-nav-toggle__bars" aria-hidden="true">
          <span></span><span></span><span></span>
        </span>
      </button>
    </div>
  </div>

  <!-- Mobile panel. Rendered in the DOM and hidden by default so it works
       without waiting for hydration; the toggle only flips an attribute. -->
  <div class="mobile" id="nt-mobile-nav" hidden>
    <nav class="nt-wrap" aria-label="Primary, mobile">
      <ul class="mobile__list">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                class="mobile__link"
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
              {item.children && (
                <ul class="mobile__sub">
                  {item.children.map((child) => (
                    <li>
                      <a href={child.href} class="mobile__sublink">
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
        <li>
          <a href="/contact/" class="mobile__link">Contact</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .nt-site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--nt-white);
    border-bottom: var(--nt-hair) solid var(--nt-hairline);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--nt-5);
    min-height: var(--nt-header-h);
  }

  .brand {
    text-decoration: none;
    flex: none;
  }

  .brand:focus-visible {
    outline-offset: 4px;
  }

  /* -- Desktop nav ------------------------------------------------------ */
  .nav {
    display: none;
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: var(--nt-6);
    list-style: none;
  }

  .nav__item {
    position: relative;
  }

  .nav__link {
    display: block;
    padding-block: 1.55rem;
    color: var(--nt-navy-900);
    font-size: var(--nt-fs-sm);
    font-weight: 500;
    text-decoration: none;
    border-bottom: 2px solid transparent;
    transition: color var(--nt-dur) var(--nt-ease),
      border-color var(--nt-dur) var(--nt-ease);
  }

  .nav__link:hover {
    color: var(--nt-teal-800);
  }

  .nav__link[aria-current='page'] {
    border-bottom-color: var(--nt-accent-rule);
  }

  /* -- Flyout: opened by hover or keyboard focus, no JS ----------------- */
  .menu {
    position: absolute;
    top: 100%;
    left: calc(var(--nt-4) * -1);
    min-width: 21rem;
    background: var(--nt-white);
    border: var(--nt-hair) solid var(--nt-hairline);
    border-top-color: var(--nt-accent-rule);
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--nt-dur) var(--nt-ease),
      visibility var(--nt-dur) var(--nt-ease);
  }

  .has-menu:hover .menu,
  .has-menu:focus-within .menu {
    opacity: 1;
    visibility: visible;
  }

  .menu__list {
    list-style: none;
  }

  .menu__list > li + li {
    border-top: var(--nt-hair) solid var(--nt-hairline-soft);
  }

  .menu__link {
    display: block;
    padding: var(--nt-4);
    text-decoration: none;
    transition: background var(--nt-dur) var(--nt-ease);
  }

  .menu__link:hover {
    background: var(--nt-line-100);
  }

  .menu__label {
    display: block;
    color: var(--nt-navy-900);
    font-size: var(--nt-fs-sm);
    font-weight: 500;
  }

  .menu__link:hover .menu__label {
    color: var(--nt-teal-800);
  }

  .menu__note {
    display: block;
    margin-top: 2px;
    color: var(--nt-text-muted);
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  /* -- Actions --------------------------------------------------------- */
  .actions {
    display: flex;
    align-items: center;
    gap: var(--nt-3);
    flex: none;
  }

  .cta {
    display: none;
    min-height: 2.625rem;
    padding-inline: var(--nt-4);
  }

  .nt-nav-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: var(--nt-hair) solid var(--nt-hairline);
    background: transparent;
    cursor: pointer;
  }

  .nt-nav-toggle__bars {
    display: grid;
    gap: 4px;
    width: 18px;
  }

  .nt-nav-toggle__bars > span {
    display: block;
    height: var(--nt-hair);
    background: var(--nt-navy-900);
    transition: transform var(--nt-dur) var(--nt-ease),
      opacity var(--nt-dur) var(--nt-ease);
  }

  .nt-nav-toggle[aria-expanded='true'] .nt-nav-toggle__bars > span:nth-child(1) {
    transform: translateY(5px) rotate(45deg);
  }

  .nt-nav-toggle[aria-expanded='true'] .nt-nav-toggle__bars > span:nth-child(2) {
    opacity: 0;
  }

  .nt-nav-toggle[aria-expanded='true'] .nt-nav-toggle__bars > span:nth-child(3) {
    transform: translateY(-5px) rotate(-45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .nt-nav-toggle__bars > span,
    .menu {
      transition: none;
    }
  }

  /* -- Mobile panel ---------------------------------------------------- */
  .mobile {
    border-top: var(--nt-hair) solid var(--nt-hairline-soft);
    background: var(--nt-white);
    max-height: calc(100dvh - var(--nt-header-h));
    overflow-y: auto;
  }

  .mobile[hidden] {
    display: none;
  }

  .mobile__list {
    list-style: none;
    padding-block: var(--nt-2) var(--nt-5);
  }

  .mobile__link {
    display: block;
    padding-block: var(--nt-4);
    border-bottom: var(--nt-hair) solid var(--nt-hairline-soft);
    color: var(--nt-navy-900);
    font-size: 1.125rem;
    font-weight: 500;
    text-decoration: none;
  }

  .mobile__link[aria-current='page'] {
    color: var(--nt-teal-800);
  }

  .mobile__sub {
    list-style: none;
    padding-left: var(--nt-4);
    border-left: var(--nt-hair) solid var(--nt-accent-rule);
    margin-block: var(--nt-3);
    display: grid;
    gap: var(--nt-3);
  }

  .mobile__sublink {
    color: var(--nt-ink-600);
    font-size: var(--nt-fs-sm);
    text-decoration: none;
  }

  .mobile__sublink:hover {
    color: var(--nt-teal-800);
  }

  /* -- Breakpoints ----------------------------------------------------- */
  @media (min-width: 62rem) {
    .nav,
    .cta {
      display: block;
    }

    .cta {
      display: inline-flex;
    }

    .nt-nav-toggle,
    .mobile {
      display: none !important;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const panel = document.getElementById('nt-mobile-nav');

  if (toggle && panel) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    // Escape closes the panel and returns focus to the toggle.
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !panel.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });

    // Close when the viewport grows past the mobile breakpoint, so the panel
    // is never left open behind the desktop nav.
    const wide = window.matchMedia('(min-width: 62rem)');
    wide.addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
