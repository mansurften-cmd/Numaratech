---
// NUMARATECH wordmark — a teal registration mark followed by the name set in
// Inter 600 with open tracking. Type-based so it stays crisp at any size and
// needs no raster asset.
interface Props {
  /** Rendered inside the header/footer as a link target label. */
  size?: 'sm' | 'md';
  invert?: boolean;
  class?: string;
}
const { size = 'md', invert = false, class: className = '' } = Astro.props;
---

<span
  class:list={[
    'wordmark',
    `wordmark--${size}`,
    invert && 'wordmark--invert',
    className,
  ]}
>
  <span class="nt-mark" aria-hidden="true"></span>
  <span class="wordmark__text">NUMARATECH</span>
</span>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    color: var(--nt-navy-900);
    text-decoration: none;
    white-space: nowrap;
  }

  .wordmark--invert {
    color: var(--nt-white);
  }

  .wordmark__text {
    font-family: var(--nt-font-sans);
    font-weight: 600;
    letter-spacing: 0.1em;
    line-height: 1;
  }

  .wordmark--md .wordmark__text {
    font-size: 1.0625rem;
  }

  .wordmark--sm .wordmark__text {
    font-size: 0.875rem;
    letter-spacing: 0.12em;
  }

  @media print {
    .wordmark {
      color: #000 !important;
    }
  }
</style>
