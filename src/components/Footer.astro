---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { SITE, FOOTER_NAV } from '../consts';
import Logomark from './Logomark.astro';
const year = new Date().getFullYear();

// The association logo is off until permission and the official file exist
// (see SITE.association.logo). A logo switched on without its file would
// ship a broken image on every page: fail the build instead, so Cloudflare
// deploys nothing.
const assoc = SITE.association;
if (assoc.logo && !existsSync(join(process.cwd(), 'public', assoc.logo.src))) {
  throw new Error(`SITE.association.logo points at ${assoc.logo.src}, which is not in public/.`);
}
---

<footer>
  <div class="nt-footer">
    <div class="nt-footer__col">
      <div style="display:flex; align-items:center; gap:12px">
        <Logomark size={28} />
        <span style="font-size:17px; font-weight:700; letter-spacing:.05em; color:#fff">{SITE.name}</span>
      </div>
      <div style="font-size:13.5px; line-height:1.6; max-width:22em">{SITE.tagline}</div>
      <div class="nt-footer__meta">
        {SITE.address.city}, {SITE.address.country}<br />
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a><br />
        <a href={`tel:${SITE.phoneHref}`}>{SITE.phoneDisplay}</a><br />
        <a href={SITE.whatsappHref} rel="noopener">Message on WhatsApp</a>
      </div>
    </div>

    {
      FOOTER_NAV.map((group) => (
        <div class="nt-footer__col">
          <h2>{group.heading}</h2>
          {group.links.map((link) => <a href={link.href}>{link.label}</a>)}
        </div>
      ))
    }
  </div>
  <!-- Association row: label, then the network's mark linked to its site.
       The relationship is stated in words in the legal line below. -->
  <div class="nt-assoc">
    <span class="nt-assoc__label">In association with</span>
    <a class="nt-assoc__mark" href={assoc.url} rel="noopener">
      {
        assoc.logo ? (
          <img
            class:list={['nt-assoc__logo', { 'nt-assoc__logo--plate': assoc.logo.plate }]}
            src={assoc.logo.src}
            width={assoc.logo.width}
            height={assoc.logo.height}
            alt={assoc.name}
            loading="lazy"
            decoding="async"
          />
        ) : (
          <span class="nt-assoc__word">
            G&nbsp;R&nbsp;A&nbsp;M&nbsp;P<span class="nt-assoc__sub">Network</span>
          </span>
        )
      }
    </a>
  </div>
  <div class="nt-legal">
    © {year} {SITE.legalName}. All rights reserved.<br />
    {SITE.licence.type} licence No. {SITE.licence.number}, issued by the {SITE.licence.authority}.
    {SITE.name} is associated with {assoc.name}, and is a separate business, not a member firm of the
    network.<br />
    Content on this site is general information, not tax or accounting advice.
  </div>
</footer>
