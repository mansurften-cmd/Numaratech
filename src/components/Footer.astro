---
import { SITE, FOOTER_NAV } from '../consts';
import Logomark from './Logomark.astro';
const year = new Date().getFullYear();
---

<footer>
  <div class="nt-footer">
    <div class="nt-footer__col">
      <div style="display:flex; align-items:center; gap:12px">
        <Logomark size={28} />
        <span style="font-size:17px; font-weight:700; letter-spacing:.05em; color:#fff">{SITE.name}</span>
      </div>
      <div style="font-size:13.5px; line-height:1.6; max-width:22em">{SITE.tagline}</div>
      <div class="nt-footer__meta">
        {SITE.address.line1}<br />
        {SITE.address.city}, {SITE.address.country}<br />
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a><br />
        <a href={`tel:${SITE.phoneHref}`}>{SITE.phoneDisplay}</a>
      </div>
    </div>

    {
      FOOTER_NAV.map((group) => (
        <div class="nt-footer__col">
          <h2>{group.heading}</h2>
          {group.links.map((link) => <a href={link.href}>{link.label}</a>)}
        </div>
      ))
    }
  </div>
  <div class="nt-legal">
    © {year} {SITE.legalName}. All rights reserved.<br />
    Registered in the United Arab Emirates. Content on this site is general information, not tax or
    accounting advice.
  </div>
</footer>
