---
/** FS Studio — the statements screen, drawn in hairlines.
 *  Illustrative figures; not a live product screenshot. Every figure is
 *  derived in src/demo.ts, so the subtotals cannot stop footing. */
import { DEMO_PL, fig, neg } from '../demo';

const { current: c, prior: p } = DEMO_PL;
---

<div class="nt-console">
  <div class="nt-console__bar">
    <span>FS Studio — statements</span>
    <span>IFRS · FY 2025</span>
  </div>
  <div class="nt-console__body" style="grid-template-columns:158px 1fr 176px">
    <div class="nt-console__nav">
      <div class="nt-console__navlabel" style="padding-top:0">Statements</div>
      <div class="is-on">Profit or loss</div>
      <div>Financial position</div>
      <div>Changes in equity</div>
      <div>Cash flows</div>
      <div class="nt-console__navlabel">Notes</div>
      <div>3 · Revenue</div>
      <div>7 · Income tax</div>
      <div>12 · Related parties</div>
    </div>

    <div class="nt-console__main" style="padding:20px 22px">
      <div style="font-size:13px; font-weight:600; color:var(--nt-navy); margin-bottom:3px">
        Statement of profit or loss
      </div>
      <div style="font-size:11px; color:var(--nt-mute); margin-bottom:14px">
        For the year ended 31 December 2025 · AED
      </div>
      <div class="nt-row nt-row--head" style="grid-template-columns:1fr 84px 84px">
        <span></span><span class="nt-num">2025</span><span class="nt-num">2024</span>
      </div>
      <div class="nt-row" style="grid-template-columns:1fr 84px 84px">
        <span>Revenue</span><span class="nt-num">{fig(c.revenue)}</span><span class="nt-num nt-num--mute">{fig(p.revenue)}</span>
      </div>
      <div class="nt-row" style="grid-template-columns:1fr 84px 84px">
        <span>Cost of sales</span><span class="nt-num">{neg(c.costOfSales)}</span><span class="nt-num nt-num--mute">{neg(p.costOfSales)}</span>
      </div>
      <div class="nt-row" style="grid-template-columns:1fr 84px 84px; font-weight:600; color:var(--nt-navy)">
        <span>Gross profit</span><span class="nt-num">{fig(c.grossProfit)}</span><span class="nt-num nt-num--mute" style="font-weight:400">{fig(p.grossProfit)}</span>
      </div>
      <div class="nt-row" style="grid-template-columns:1fr 84px 84px">
        <span>Administrative expenses</span><span class="nt-num">{neg(c.adminExpenses)}</span><span class="nt-num nt-num--mute">{neg(p.adminExpenses)}</span>
      </div>
      <div class="nt-row" style="grid-template-columns:1fr 84px 84px; font-weight:600; color:var(--nt-navy)">
        <span>Profit before tax</span><span class="nt-num">{fig(c.profitBeforeTax)}</span><span class="nt-num nt-num--mute" style="font-weight:400">{fig(p.profitBeforeTax)}</span>
      </div>
      <div class="nt-row" style="grid-template-columns:1fr 84px 84px">
        <span>Income tax expense</span><span class="nt-num">{neg(c.incomeTax)}</span><span class="nt-num nt-num--mute">{neg(p.incomeTax)}</span>
      </div>
      <div class="nt-row nt-row--total" style="grid-template-columns:1fr 84px 84px">
        <span>Profit for the year</span><span class="nt-num">{fig(c.profitForTheYear)}</span><span class="nt-num nt-num--mute" style="font-weight:400">{fig(p.profitForTheYear)}</span>
      </div>
    </div>

    <div class="nt-console__side">
      <h4>Derivation</h4>
      <div style="border:1px solid var(--nt-teal); padding:10px 11px; display:flex; flex-direction:column; gap:5px">
        <span class="nt-kicker" style="font-size:9.5px; letter-spacing:.1em">Mapping changed</span>
        <span style="font-size:12px; line-height:1.5; color:var(--nt-navy)">4 notes updated with it.</span>
      </div>
      <div style="display:flex; flex-direction:column; gap:7px">
        <div class="nt-meter"><span>Ledger accounts</span><span>412</span></div>
        <div class="nt-meter"><span>Mapped</span><span>412</span></div>
        <div class="nt-meter"><span>Unmapped</span><span style="color:var(--nt-teal)">0</span></div>
      </div>
      <div class="nt-console__cta">Export signed set</div>
    </div>
  </div>
</div>
<p class="nt-console__caption">Illustrative figures.</p>
