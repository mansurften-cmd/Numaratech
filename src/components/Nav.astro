---
/** The dark nav band. Renders NAV from consts.ts, with hover/focus dropdowns
 *  for the two sections that have children.
 *
 *  Below 721px the same list becomes a drawer behind a toggle. The toggle is
 *  progressive enhancement: the markup ships with the links stacked and
 *  reachable, and the script sets data-nav="ready" on the band, which is what
 *  activates the collapsed drawer styling. If the script never runs the nav
 *  degrades to a plain stacked list rather than to nothing. */
import { NAV } from '../consts';
import Logomark from './Logomark.astro';

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<div class="nt-nav">
  <a class="nt-brand" href="/" aria-label="NUMARATECH — home">
    <Logomark size={32} />
    <span style="display:flex; flex-direction:column; gap:5px">
      <span class="nt-brand__name">NUMARATECH</span>
      <span class="nt-brand__strap">ACCOUNTING · TAX · ADVISORY</span>
    </span>
  </a>

  <button
    class="nt-burger"
    type="button"
    aria-expanded="false"
    aria-controls="nt-menu"
    aria-label="Open menu"
  >
    <span class="nt-burger__bars" aria-hidden="true"></span>
  </button>

  <nav class="nt-nav__links" id="nt-menu" aria-label="Primary">
    {
      NAV.map((item, i) =>
        item.children ? (
          <span class={`nt-nav__item${isCurrent(item.href) ? ' nt-nav__item--current' : ''}`}>
            <a
              href={item.href}
              aria-haspopup="true"
              aria-expanded="false"
              aria-controls={`nt-submenu-${i}`}
            >
              {item.label}
            </a>
            <span class="nt-nav__menu" id={`nt-submenu-${i}`}>
              {item.children.map((child) => (
                <a href={child.href}>
                  {child.label}
                  {child.note && <i>{child.note}</i>}
                </a>
              ))}
            </span>
          </span>
        ) : (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        )
      )
    }
    <a class="nt-btn nt-btn--sm" href="/contact/">Book a walkthrough</a>
  </nav>

  <div class="nt-nav__scrim" hidden></div>
</div>

<script>
  // Bundled to an external file (no is:inline), because the site's CSP is
  // script-src 'self' with no 'unsafe-inline'.
  const band = document.querySelector<HTMLElement>('.nt-nav');
  const toggle = band?.querySelector<HTMLButtonElement>('.nt-burger');
  const menu = band?.querySelector<HTMLElement>('#nt-menu');
  const scrim = band?.querySelector<HTMLElement>('.nt-nav__scrim');

  if (band && toggle && menu && scrim) {
    // Only now does the collapsed-drawer CSS apply. Before this line the links
    // are stacked and reachable, so a failed script leaves a usable nav.
    band.dataset.nav = 'ready';

    const DESKTOP = window.matchMedia('(min-width: 721px)');
    const FOCUSABLE = 'a[href], button:not([disabled]), input, select, textarea, [tabindex]:not([tabindex="-1"])';

    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      band.dataset.open = String(open);
      scrim.hidden = !open;
      // Stops the page scrolling behind the drawer. Restored, not cleared, so
      // we do not stomp on anything else that may set it.
      document.body.style.overflow = open ? 'hidden' : '';
    };

    const close = (returnFocus = true) => {
      if (!isOpen()) return;
      setOpen(false);
      if (returnFocus) toggle.focus();
    };

    toggle.addEventListener('click', () => {
      if (isOpen()) {
        close();
      } else {
        setOpen(true);
        // Land on the first link rather than leaving focus on the toggle, so
        // the next Tab continues through the menu instead of leaving it.
        menu.querySelector<HTMLElement>(FOCUSABLE)?.focus();
      }
    });

    scrim.addEventListener('click', () => close());

    // Anything outside the band closes it — the scrim covers the viewport
    // below the header, this covers the header itself.
    document.addEventListener('pointerdown', (event) => {
      if (!isOpen()) return;
      if (!band.contains(event.target as Node)) close(false);
    });

    document.addEventListener('keydown', (event) => {
      if (!isOpen()) return;

      if (event.key === 'Escape') {
        event.preventDefault();
        close();
        return;
      }

      if (event.key !== 'Tab') return;

      // Focus trap. The toggle is part of the cycle: it is the control that
      // closes the drawer, so it must stay reachable from inside it.
      const items = [toggle, ...Array.from(menu.querySelectorAll<HTMLElement>(FOCUSABLE))].filter(
        (el) => el.offsetParent !== null || el === toggle
      );
      if (items.length === 0) return;

      const first = items[0];
      const last = items[items.length - 1];
      const active = document.activeElement;

      if (event.shiftKey && active === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && active === last) {
        event.preventDefault();
        first.focus();
      } else if (!band.contains(active as Node)) {
        event.preventDefault();
        first.focus();
      }
    });

    // Following a link inside the drawer navigates, but same-page anchors do
    // not, and a drawer left open over the target is worse than useless.
    menu.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) close(false);
    });

    // Crossing back to the desktop layout must not leave body scroll locked by
    // a drawer that is no longer rendered.
    DESKTOP.addEventListener('change', (event) => {
      if (event.matches) close(false);
    });
  }

  // Desktop dropdowns. CSS opens them on :hover and :focus-within, which
  // works for mouse and keyboard but tells a screen reader nothing. Mirror
  // the open state onto aria-expanded, and on a touch device at desktop
  // width — where :hover does not exist — let the first tap open the menu
  // and the second follow the link.
  const desktopQuery = window.matchMedia('(min-width: 721px)');
  const coarsePointer = window.matchMedia('(hover: none)');

  document.querySelectorAll<HTMLElement>('.nt-nav__item').forEach((item) => {
    const link = item.querySelector<HTMLAnchorElement>(':scope > a[aria-haspopup]');
    if (!link) return;

    const setOpen = (open: boolean) => {
      link.setAttribute('aria-expanded', String(open));
      item.dataset.open = String(open);
    };

    // Below 721px the submenus render inline and permanently open, so the
    // honest state there is "expanded". Re-evaluated when the layout changes.
    const syncLayout = () => setOpen(!desktopQuery.matches);
    syncLayout();
    desktopQuery.addEventListener('change', syncLayout);

    // Pointer, not mouse: on a touch device the tap sequence fires
    // mouseenter before click, which would mark the menu open before the
    // click handler could act on the first tap.
    //
    // Closing is deferred. A pointer heading diagonally for a submenu link
    // often leaves the item's box for a moment; closing instantly made the
    // menu vanish under the cursor. 220ms is short enough to feel immediate
    // when you really do leave, long enough to survive the crossing. The CSS
    // bridge on .nt-nav__menu::before covers the vertical gap; this covers
    // the diagonal.
    let closeTimer: number | undefined;
    item.addEventListener('pointerenter', (event) => {
      if (event.pointerType === 'touch' || !desktopQuery.matches) return;
      window.clearTimeout(closeTimer);
      setOpen(true);
    });
    item.addEventListener('pointerleave', (event) => {
      if (event.pointerType === 'touch' || !desktopQuery.matches) return;
      window.clearTimeout(closeTimer);
      closeTimer = window.setTimeout(() => setOpen(false), 220);
    });
    item.addEventListener('focusin', () => {
      if (desktopQuery.matches) setOpen(true);
    });
    item.addEventListener('focusout', (event) => {
      if (desktopQuery.matches && !item.contains(event.relatedTarget as Node | null)) setOpen(false);
    });
    item.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && desktopQuery.matches) {
        setOpen(false);
        link.focus();
      }
    });
    link.addEventListener('click', (event) => {
      if (coarsePointer.matches && desktopQuery.matches && item.dataset.open !== 'true') {
        event.preventDefault();
        setOpen(true);
      }
    });
  });
</script>
