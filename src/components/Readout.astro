---
// A monospace status strip — hairline-separated fields, like an instrument
// readout. Static content: nothing here animates except the caret, so it
// carries no dependency on script.
interface Props {
  items: { label: string; value: string }[];
  /** Adds a blinking caret after the final value. */
  caret?: boolean;
  class?: string;
}
const { items, caret = false, class: className = '' } = Astro.props;
---

<dl class:list={['readout', className]}>
  {
    items.map((item, i) => (
      <div class="readout__cell">
        <dt class="readout__label">{item.label}</dt>
        <dd
          class:list={[
            'readout__value',
            caret && i === items.length - 1 && 'nt-caret',
          ]}
        >
          {item.value}
        </dd>
      </div>
    ))
  }
</dl>

<style>
  .readout {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    margin: 0;
    border-top: var(--nt-hair) solid var(--nt-hairline);
    border-bottom: var(--nt-hair) solid var(--nt-hairline);
    font-family: var(--nt-font-mono);
    font-size: var(--nt-fs-micro);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .readout__cell {
    display: flex;
    align-items: baseline;
    gap: var(--nt-2);
    padding: var(--nt-3) var(--nt-4);
    border-right: var(--nt-hair) solid var(--nt-hairline-soft);
    flex: 1 1 auto;
  }

  .readout__cell:first-child {
    padding-left: 0;
  }

  .readout__cell:last-child {
    border-right: 0;
  }

  .readout__label {
    color: var(--nt-text-muted);
    white-space: nowrap;
  }

  .readout__value {
    margin: 0;
    color: var(--nt-navy-900);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  @media print {
    .readout {
      display: none;
    }
  }
</style>
