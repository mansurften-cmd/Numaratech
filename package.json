{
  "name": "numaratech-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "NUMARATECH corporate website — finance and compliance infrastructure for UAE businesses.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "deploy": "astro build && wrangler deploy",
    "deploy:dry": "astro build && wrangler deploy --dry-run",
    "check:headers": "node scripts/check-headers.mjs",
    "check:html": "html-validate \"dist/**/*.html\"",
    "test": "astro check && astro build && npm run check:headers && npm run check:html",
    "verify:serve": "python3 scripts/verify/serve-with-csp.py 4322",
    "verify": "node scripts/verify/verify.mjs",
    "verify:snapshot": "node scripts/verify/snapshot.mjs",
    "verify:mobile": "node scripts/verify/mobile-sweep.mjs /tmp/nt-mobile-shots",
    "verify:nav": "node scripts/verify/nav-breakpoint.mjs /tmp/nt-mobile-shots"
  },
  "dependencies": {
    "astro": "^7.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.5",
    "axe-core": "^4.14.0",
    "html-validate": "^11.16.3",
    "satori": "^0.29.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.151.1"
  }
}
